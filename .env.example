# Server Settings
PORT=3000
TIMEZONE=Asia/Phnom_Penh
PUBLIC_URL=
CRON_SECRET=change_this_cron_secret

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=change_this_webhook_secret
# Comma-separated Telegram Chat IDs allowed to use the bot (leave blank on first run to auto-register owner on /start)
TELEGRAM_ALLOWED_CHAT_IDS=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ngrok Settings
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_AUTOSTART=true
NGROK_BINARY=C:\ngrok\ngrok.exe
NGROK_DOMAIN=

# Google Workspace Sheet Settings
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Transactions

# Option A (Recommended - easiest): Deploy google-apps-script/Code.gs and paste its Web App URL here
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=kh_sheet_sync_2026

# Option B (Alternative): Path to Google Cloud Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json

# Monthly Report Schedule (Payday cycle: 28th prev month -> 27th current month, sent on 27th at 16:00)
MONTHLY_REPORT_DAY=27
MONTHLY_REPORT_CYCLE_START_DAY=28
MONTHLY_REPORT_HOUR=16
MONTHLY_REPORT_MINUTE=0

# Bi-monthly Water Bill Reminder (every 2 months, days 16-18)
WATER_BILL_ENABLED=true
WATER_BILL_ANCHOR_MONTH=2027-01
WATER_BILL_REMINDER_HOUR=9
WATER_BILL_REMINDER_MINUTE=0
